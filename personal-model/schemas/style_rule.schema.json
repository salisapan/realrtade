{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iglu:ai.theflow.glance/personal-style_rule/jsonschema/1-0-0",
  "description": "A style rule the person edited. No decay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "audience",
    "lang",
    "greeting",
    "signoff",
    "formality"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Random rule id."
    },
    "audience": {
      "type": "string",
      "enum": [
        "client",
        "colleague",
        "family",
        "unknown"
      ],
      "maxLength": 16,
      "description": "Who the rule is for."
    },
    "lang": {
      "type": "string",
      "enum": [
        "he",
        "en",
        "mixed",
        "other"
      ],
      "maxLength": 8,
      "description": "Language the rule applies to."
    },
    "greeting": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "Greeting the person chose."
    },
    "signoff": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "Sign-off the person chose."
    },
    "formality": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "casual neutral or formal."
    }
  }
}
