{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iglu:ai.theflow.glance/personal-entity/jsonschema/1-0-0",
  "description": "The user or another person. Address payload is encrypted at rest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "canonical_email"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Random entity id."
    },
    "kind": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "user or person."
    },
    "canonical_email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "Lower-case address. Encrypted in IndexedDB."
    }
  }
}
