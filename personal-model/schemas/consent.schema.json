{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iglu:ai.theflow.glance/personal-consent/jsonschema/1-0-0",
  "description": "One category switch. Off until the person accepts the disclosure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "enabled"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "people",
        "habits",
        "style",
        "work",
        "places",
        "identity"
      ],
      "maxLength": 16,
      "description": "people habits style work places or identity."
    },
    "enabled": {
      "type": "boolean",
      "description": "False until the disclosure is accepted."
    },
    "granted_at": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$",
      "description": "When the person accepted. Empty while off."
    }
  }
}
