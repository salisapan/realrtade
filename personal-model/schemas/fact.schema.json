{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iglu:ai.theflow.glance/personal-fact/jsonschema/1-0-0",
  "description": "One bi-temporal statement. A change inserts a new row and closes the old one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject_id",
    "predicate",
    "object",
    "source",
    "confidence",
    "valid_from",
    "learned_at",
    "consent_category",
    "schema_ver",
    "provenance",
    "status",
    "memory_space",
    "context_of_origin",
    "importance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Random id. Not derived from mail."
    },
    "subject_id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "The entity this fact is about."
    },
    "predicate": {
      "type": "string",
      "enum": [
        "person.tie_strength",
        "person.reply_latency_to",
        "person.reply_latency_from",
        "person.channel",
        "person.language",
        "person.relation",
        "identity.name",
        "identity.role",
        "identity.org",
        "work.org",
        "work.works_on",
        "work.client_of",
        "work.commitment",
        "habit.meeting_hour",
        "habit.duration",
        "habit.tool",
        "habit.working_hours",
        "place.city",
        "style.greeting",
        "style.signoff",
        "style.length",
        "style.formality",
        "style.emoji",
        "style.mixing",
        "style.edit_distance",
        "style.vector"
      ],
      "maxLength": 64,
      "description": "Controlled predicate token."
    },
    "object": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "Short object token. Never a mail body."
    },
    "source": {
      "type": "string",
      "enum": [
        "observed",
        "inferred",
        "user_stated"
      ],
      "maxLength": 16,
      "description": "observed or inferred or user_stated."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Score from 0 to 1. User-confirmed facts stay at 1."
    },
    "valid_from": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$",
      "description": "When this value became true."
    },
    "valid_to": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$",
      "description": "When this value stopped being current. Empty while current."
    },
    "learned_at": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$",
      "description": "When Glance recorded the row."
    },
    "retired_at": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$",
      "description": "When the row was invalidated. Empty while current."
    },
    "consent_category": {
      "type": "string",
      "enum": [
        "people",
        "habits",
        "style",
        "work",
        "places",
        "identity"
      ],
      "maxLength": 16,
      "description": "Which consent gate allows this row."
    },
    "schema_ver": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "Schema version token."
    },
    "provenance": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "user_said, user_sent, user_action, or third_party_content."
    },
    "status": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "active or candidate. A candidate is not used until the person confirms it."
    },
    "memory_space": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "work, personal, or client and an id."
    },
    "context_of_origin": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "Where the fact was learned."
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Normalized importance for retrieval."
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "description": "Pointers only. No mail body.",
      "items": {
        "$ref": "evidence.schema.json"
      }
    }
  }
}
