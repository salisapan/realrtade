{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iglu:ai.theflow.glance/personal-evidence/jsonschema/1-0-0",
  "description": "A pointer to a message or event. Never the body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "message_or_event_id",
    "ts"
  ],
  "properties": {
    "surface": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "gmail outlook or calendar."
    },
    "message_or_event_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9\\u0590-\\u05FF][A-Za-z0-9\\u0590-\\u05FF _.:@+-]{0,253}$",
      "description": "Opaque id. Not a body and not an address."
    },
    "ts": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$",
      "description": "When that message or event happened."
    },
    "span_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Start offset of the cited span. The characters are not stored."
    },
    "span_end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "description": "End offset of the cited span. The characters are not stored."
    }
  }
}
