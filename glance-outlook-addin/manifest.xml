<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>7c9f2b44-6a0e-4f5a-9c2d-glance-outlook-addin</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Flow AI</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Glance" />
  <Description DefaultValue="Glance closes open loops inside Outlook. Draft only, never send." />
  <IconUrl DefaultValue="https://theflow-ai.com/apple-touch-icon.png" />
  <HighResolutionIconUrl DefaultValue="https://theflow-ai.com/apple-touch-icon.png" />
  <SupportUrl DefaultValue="https://theflow-ai.com/privacy" />
  <AppDomains>
    <AppDomain>https://theflow-ai.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://theflow-ai.com/glance-outlook-addin/src/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="Glance.Group" label="Glance">
                <Control xsi:type="Button" id="Glance.Taskpane">
                  <Label resid="Glance.Label" />
                  <Supertip>
                    <Title resid="Glance.Label" />
                    <Description resid="Glance.Desc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Glance.Icon" />
                    <bt:Image size="32" resid="Glance.Icon" />
                    <bt:Image size="80" resid="Glance.Icon" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
        <MobileFormFactor>
          <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
            <Group id="Glance.MobileGroup" label="Glance">
              <Control xsi:type="MobileButton" id="Glance.MobileButton">
                <Label resid="Glance.Label" />
                <Icon>
                  <bt:Image size="25" scale="1" resid="Glance.Icon" />
                  <bt:Image size="25" scale="2" resid="Glance.Icon" />
                  <bt:Image size="25" scale="3" resid="Glance.Icon" />
                </Icon>
                <Action xsi:type="ShowTaskpane">
                  <SourceLocation resid="Taskpane.Url" />
                </Action>
              </Control>
            </Group>
          </ExtensionPoint>
        </MobileFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Glance.Icon" DefaultValue="https://theflow-ai.com/apple-touch-icon.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://theflow-ai.com/glance-outlook-addin/src/taskpane.html" />
        <bt:Url id="Runtime.Url" DefaultValue="https://theflow-ai.com/glance-outlook-addin/src/functions.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Glance.Label" DefaultValue="Glance" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Glance.Desc" DefaultValue="Close the open loop with a draft reply. Never send." />
      </bt:LongStrings>
    </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Runtime.Url" lifetime="short" />
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Runtime.Url" />
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageCompose" />
              </LaunchEvents>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Urls>
          <bt:Url id="Runtime.Url" DefaultValue="https://theflow-ai.com/glance-outlook-addin/src/functions.html" />
        </bt:Urls>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
