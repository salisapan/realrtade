{
  "manifest_version": 3,
  "name": "Flow Trial",
  "short_name": "Flow",
  "version": "0.1.0",
  "description": "Flow watches Gmail quietly and surfaces a single Do It action when it recognizes something worth syncing to your CRM. No prompts, no rules to configure.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/domains.js", "src/connectors.js", "src/judgment.js", "src/storage.js", "src/content-gmail.js"],
      "css": ["src/chip.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"]
}
