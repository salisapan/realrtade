{
  "manifest_version": 3,
  "name": "Flow Trial",
  "short_name": "Flow",
  "version": "0.4.0",
  "description": "Flow watches Gmail quietly and, when an email actually decides something, puts one Do It button next to it that writes the record for you. No prompts, no rules, no chat.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/domains.js",
        "src/connectors.js",
        "src/extract.js",
        "src/judgment.js",
        "src/storage.js",
        "src/content-gmail.js"
      ],
      "css": [
        "src/chip.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://api.hubapi.com/*",
    "https://api.notion.com/*",
    "https://*.salesforce.com/*",
    "https://slack.com/*",
    "https://api.monday.com/*"
  ]
}
